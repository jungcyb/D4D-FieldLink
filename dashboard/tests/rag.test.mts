import {test} from "node:test";
import type {TestContext} from "node:test";
import assert from "node:assert/strict";
import {mkdtempSync,rmSync} from "node:fs";
import {tmpdir} from "node:os";
import {join} from "node:path";
import {FileRepository} from "../lib/server/repository.ts";
import {MaintenanceService} from "../lib/server/service.ts";
import {RagService} from "../lib/server/rag.ts";
import {ApiError} from "../lib/server/validation.ts";
const uuid="11111111-2222-4333-8444-555555555555";
function setup(t:TestContext){const directory=mkdtempSync(join(tmpdir(),"fieldlink-rag-test-"));t.after(()=>rmSync(directory,{recursive:true,force:true}));const repo=new FileRepository(directory,"external"),svc=new MaintenanceService(repo),rag=new RagService(repo);svc.upsertBoard({uuid,label:"DAQ-RAG",ip:"192.168.1.50",port:9000});const equipment=svc.saveEquipment({name:"펌프",category:"펌프",location:"A실"});svc.bindBoard(uuid,{equipmentId:equipment.id});const sensor=svc.saveSensor({daqUuid:uuid,channel:"CH1",name:"진동",type:"vibration",position:"모터 하우징",unit:"g",sps:1000});svc.ingest({daqUuid:uuid,frameId:"frame-1",readings:[{channel:"CH1",timestamp:new Date(Date.now()-10000).toISOString(),value:1.2,sps:1000,raw:[-2,0,2,4]}],diagnoses:[{channel:"CH1",severity:"warning",title:"진동 증가",description:"입력 진단",rulHours:50,model:"edge-v1"}]});return{repo,svc,rag,sensor};}
function endpoint(t:TestContext){const keys=["RAG_API_URL","RAG_API_TOKEN"] as const,previous=keys.map(k=>process.env[k]);t.after(()=>keys.forEach((key,index)=>{if(previous[index]===undefined)delete process.env[key];else process.env[key]=previous[index];}));process.env.RAG_API_URL="http://127.0.0.1:8100/query";process.env.RAG_API_TOKEN="test-token";}
test("context includes DAQ, placement, current diagnosis and batch metadata without full raw",t=>{const{rag,sensor}=setup(t);const envelope=rag.context({daqUuid:uuid});assert.equal(envelope.schemaVersion,"fieldlink.rag.v1");assert.equal(envelope.context.daq.uuid,uuid);assert.equal(envelope.context.placement.sensors[0].position,"모터 하우징");assert.equal(envelope.context.status.sensors[0].diagnosis?.rulHours,50);assert.equal(envelope.context.batches[0].sampleCount,4);assert.equal(envelope.context.batches[0].rawSummary?.mean,1);assert.equal(envelope.context.batches[0].rawSummary?.rms,Math.sqrt(6));assert.equal(envelope.context.batches[0].rawPreview,undefined);assert.equal("raw" in envelope.context.batches[0],false);assert.equal(envelope.context.coverage.perSensor[0].sensorId,sensor.id);});
test("scope validation and bounded raw extrema preview",t=>{const{rag,svc,sensor}=setup(t);assert.throws(()=>rag.context({daqUuid:uuid,sensorIds:["foreign"]}),/属|속하지/);assert.throws(()=>rag.context({daqUuid:uuid,sensorIds:[sensor.id,sensor.id]}),/고유/);assert.throws(()=>rag.context({daqUuid:uuid,batchesPerSensor:11}),/배치/);assert.throws(()=>rag.context({daqUuid:uuid,includeRawPreview:"true"}),/boolean/);const samples=Array.from({length:4096},()=>0);samples[123]=100;samples[222]=-90;svc.ingest({daqUuid:uuid,readings:[{channel:"CH1",timestamp:new Date().toISOString(),value:0,sps:1000,raw:samples}]});const envelope=rag.context({daqUuid:uuid,batchesPerSensor:1,includeRawPreview:true}),batch=envelope.context.batches[0];assert.ok(batch.rawPreview!.length<=32);assert.ok(batch.rawPreview!.some(p=>p.value===100));assert.ok(batch.rawPreview!.some(p=>p.value===-90));assert.equal(envelope.context.batches.length,1);});
test("missing telemetry and disconnected DAQ remain explicit",t=>{const{rag,repo,svc}=setup(t);const second=svc.saveSensor({daqUuid:uuid,channel:"CH2",name:"온도",type:"temperature",position:"상단",unit:"C",sps:1});repo.mutate(store=>{store.daqs[0].lastSeen=new Date(Date.now()-60000).toISOString();});const context=rag.context({daqUuid:uuid,sensorIds:[second.id]}).context;assert.equal(context.status.daqOnline,false);assert.equal(context.status.sensors[0].severity,"unknown");assert.equal(context.status.sensors[0].dataAgeMs,null);assert.equal(context.batches.length,0);assert.equal(context.coverage.perSensor[0].includedBatches,0);});
test("query refreshes backend context and validates source batch citations",async t=>{endpoint(t);const{rag,svc,sensor}=setup(t);const preview=rag.context({daqUuid:uuid});svc.ingest({daqUuid:uuid,frameId:"new-frame",readings:[{channel:"CH1",timestamp:new Date().toISOString(),value:9,sps:1000,raw:[9]}]});let request:Record<string,unknown>={};const fetcher=(async(url,options)=>{assert.equal(String(url),process.env.RAG_API_URL);assert.equal((options?.headers as Record<string,string>).Authorization,"Bearer test-token");request=JSON.parse(String(options?.body));const envelope=request as unknown as ReturnType<RagService["context"]>;assert.equal(envelope.context.status.sensors[0].latestValue,9);return Response.json({answer:"최근 진동 변화와 엣지 진단을 확인하세요.",model:"local-rag",citations:[{title:"수신 배치",source:"현장 데이터",sensorId:sensor.id,batchId:envelope.context.batches.at(-1)!.id}]});}) as typeof fetch;
 const result=await rag.query({daqUuid:uuid,question:"현재 상태?",history:[{role:"user",content:"이전 질문",daqUuid:uuid},{role:"assistant",content:"이전 답변",daqUuid:uuid}],context:preview.context},fetcher);assert.equal(result.contextStats.batches,2);assert.equal(result.citations[0].sensorId,sensor.id);assert.equal(typeof request.requestId,"string");assert.equal(result.model,"local-rag");assert.deepEqual((request.history as {content:string}[]).map(m=>m.content),["이전 질문","이전 답변"]);assert.equal(result.selection.sensorIds[0],sensor.id);
 const bad=(async()=>Response.json({answer:"답변",citations:[{title:"가짜 배치",batchId:"missing"}]})) as typeof fetch;await assert.rejects(rag.query({daqUuid:uuid,question:"상태?"},bad),(e:unknown)=>e instanceof ApiError&&e.status===502&&e.code==="RAG_INVALID_RESPONSE");});
test("unconfigured, unreachable and invalid JSON RAG responses produce honest errors",async t=>{endpoint(t);const{rag}=setup(t);delete process.env.RAG_API_URL;await assert.rejects(rag.query({daqUuid:uuid,question:"상태?"}),/RAG_API_URL/);process.env.RAG_API_URL="http://127.0.0.1:8100/query";await assert.rejects(rag.query({daqUuid:uuid,question:"상태?"},(async()=>{throw new Error("connection refused");}) as typeof fetch),/연결할 수 없습니다/);await assert.rejects(rag.query({daqUuid:uuid,question:"상태?"},(async()=>new Response("not JSON")) as typeof fetch),/JSON/);await assert.rejects(rag.query({daqUuid:uuid,question:"상태?"},(async()=>new Response("",{status:503})) as typeof fetch),(e:unknown)=>e instanceof ApiError&&e.status===502);});
