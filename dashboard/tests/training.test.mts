import {test,type TestContext} from "node:test";
import assert from "node:assert/strict";
import {mkdtempSync,rmSync} from "node:fs";
import {tmpdir} from "node:os";
import {join,resolve,basename} from "node:path";
import {FileRepository} from "../lib/server/repository.ts";
import {MaintenanceService} from "../lib/server/service.ts";
import {OperationsService} from "../lib/server/operations.ts";
import {AnomalyTrainingService} from "../lib/server/training.ts";
import type {CandidateReport} from "../lib/training-types.ts";
const daqUuid="11111111-2222-4333-8444-555555555555",from="2026-01-01T00:00:00.000Z",to="2026-01-01T00:02:00.000Z";
function setup(t:TestContext){const dir=mkdtempSync(join(tmpdir(),"fieldlink-training-test-"));t.after(()=>{assert.ok(resolve(dir).startsWith(resolve(tmpdir()))&&basename(dir).startsWith("fieldlink-training-test-"));rmSync(dir,{recursive:true,force:true});});
  const repo=new FileRepository(dir,"external"),svc=new MaintenanceService(repo),ops=new OperationsService(repo),training=new AnomalyTrainingService(repo);svc.upsertBoard({uuid:daqUuid,label:"DAQ",ip:"127.0.0.1",port:9000});const sensor=svc.saveSensor({daqUuid,channel:"CH0",name:"진동",type:"vibration",position:"베어링",unit:"V",sps:10});svc.ingest({daqUuid,readings:[{channel:"CH0",timestamp:from,value:1,sps:10,raw:Array(100).fill(1)}]});return{repo,svc,ops,training,sensor};}
function result(version="if-test-01"):CandidateReport{return{modelVersion:version,profileId:"sensor/v1",configurationHash:"a".repeat(64),threshold:.59,normalTestFalseAlarmRate:.05,datasetDigest:"b".repeat(64),splits:Object.fromEntries(["train","calibration","test"].map(name=>[name,{windows:20,sessions:[name],files:Array.from({length:20},(_,i)=>`${name}/${i}.npz`)}])) as CandidateReport["splits"]};}
test("normal approval and board training queue persist without inventing completed training",t=>{const{repo,ops,training,sensor}=setup(t);assert.throws(()=>training.request(sensor.id,{approvalId:"absent"}));assert.throws(()=>ops.approveNormalRange(sensor.id,{from,to,confirmNormal:false,acceptIntegrity:true}));const approval=ops.approveNormalRange(sensor.id,{from,to,confirmNormal:true,acceptIntegrity:true});const job=training.request(sensor.id,{approvalId:approval.id});assert.equal(job.status,"queued");assert.equal(job.candidate,null);assert.equal(training.request(sensor.id,{approvalId:approval.id}).id,job.id);assert.equal(training.queue(daqUuid)[0].rawSource,"daq_ring");assert.equal(new AnomalyTrainingService(new FileRepository(repo.directory,"external")).history(sensor.id).jobs[0].id,job.id);assert.throws(()=>training.report(job.id,{daqUuid:"22222222-2222-4333-8444-555555555555",bindingHash:job.bindingHash,status:"training"}),/다른 DAQ/);});
test("candidate validation rejects insufficient windows and split leakage atomically",t=>{const{ops,training,sensor}=setup(t),approval=ops.approveNormalRange(sensor.id,{from,to,confirmNormal:true,acceptIntegrity:true}),job=training.request(sensor.id,{approvalId:approval.id});
  for(const mutate of [(c:CandidateReport)=>{c.splits.test.windows=19;},(c:CandidateReport)=>{c.splits.test.sessions=["train"];},(c:CandidateReport)=>{c.splits.test.files[0]="train/0.npz";},(c:CandidateReport)=>{c.normalTestFalseAlarmRate=1.1;}]){const c=result();mutate(c);assert.throws(()=>training.report(job.id,{daqUuid,bindingHash:job.bindingHash,status:"candidate",candidate:c}));assert.equal(training.history(sensor.id).jobs[0].status,"queued");}
});
test("candidate is not activated until user approval and matching board acknowledgment",t=>{const{ops,training,sensor}=setup(t),approval=ops.approveNormalRange(sensor.id,{from,to,confirmNormal:true,acceptIntegrity:true}),job=training.request(sensor.id,{approvalId:approval.id});const payload={daqUuid,bindingHash:job.bindingHash};training.report(job.id,{...payload,status:"candidate",candidate:result()});assert.throws(()=>training.report(job.id,{...payload,status:"active"}),/승인/);assert.throws(()=>training.activate(job.id,{confirmActivation:false}));const applying=training.activate(job.id,{confirmActivation:true});assert.equal(applying.status,"activation_requested");assert.throws(()=>training.report(job.id,{...payload,status:"active",activationRequestId:"wrong",modelVersion:"if-test-01",configurationHash:"a".repeat(64)}));const active=training.report(job.id,{...payload,status:"active",activationRequestId:applying.activationRequestId,modelVersion:"if-test-01",configurationHash:"a".repeat(64)});assert.equal(active.status,"active");});
test("sensor changes invalidate approval and candidate activation bindings",t=>{const{svc,ops,training,sensor}=setup(t),approval=ops.approveNormalRange(sensor.id,{from,to,confirmNormal:true,acceptIntegrity:true});svc.calibrateSensor(sensor.id,{scale:2,offset:0,inputUnit:"V"});assert.throws(()=>training.request(sensor.id,{approvalId:approval.id}),/설정/);const nextApproval=ops.approveNormalRange(sensor.id,{from,to,confirmNormal:true,acceptIntegrity:true});assert.notEqual(nextApproval.id,approval.id);const job=training.request(sensor.id,{approvalId:nextApproval.id});training.report(job.id,{daqUuid,bindingHash:job.bindingHash,status:"candidate",candidate:result()});svc.calibrateSensor(sensor.id,{scale:3,offset:0,inputUnit:"V"});assert.throws(()=>training.activate(job.id,{confirmActivation:true}),/설정/);});
test("new candidate keeps active model until ACK, rollback uses a fresh activation request",t=>{const{svc,ops,training,sensor}=setup(t);
  const approve=(end:string)=>ops.approveNormalRange(sensor.id,{from,to:end,confirmNormal:true,acceptIntegrity:true});
  const first=training.request(sensor.id,{approvalId:approve(to).id});training.report(first.id,{daqUuid,bindingHash:first.bindingHash,status:"candidate",candidate:result("if-01")});const applying=training.activate(first.id,{confirmActivation:true});const ack=(id:string,bindingHash:string,requestId:string|null,modelVersion:string)=>training.report(id,{daqUuid,bindingHash,status:"active",activationRequestId:requestId,modelVersion,configurationHash:"a".repeat(64)});ack(first.id,first.bindingHash,applying.activationRequestId,"if-01");
  const second=training.request(sensor.id,{approvalId:approve("2026-01-01T00:03:00.000Z").id});training.report(second.id,{daqUuid,bindingHash:second.bindingHash,status:"candidate",candidate:result("if-02")});assert.equal(training.history(sensor.id).jobs.find(j=>j.id===first.id)?.status,"active");const next=training.activate(second.id,{confirmActivation:true});ack(second.id,second.bindingHash,next.activationRequestId,"if-02");assert.equal(training.history(sensor.id).jobs.find(j=>j.id===first.id)?.status,"superseded");const rollback=training.activate(first.id,{confirmActivation:true});assert.notEqual(rollback.activationRequestId,applying.activationRequestId);assert.equal(rollback.requestedAction,"rollback");assert.throws(()=>ack(first.id,first.bindingHash,applying.activationRequestId,"if-01"));ack(first.id,first.bindingHash,rollback.activationRequestId,"if-01");assert.equal(training.history(sensor.id).jobs.filter(j=>j.status==="active").length,1);assert.equal(svc.rawWindow(sensor.id,400).points.length<=400,true);
});
