import {test} from "node:test";
import assert from "node:assert/strict";
import {mkdtempSync,readFileSync,rmSync} from "node:fs";
import {tmpdir} from "node:os";
import {join} from "node:path";
import {gunzipSync} from "node:zlib";
import {FileRepository} from "../lib/server/repository.ts";
import {MaintenanceService} from "../lib/server/service.ts";
import {OperationsService,state} from "../lib/server/operations.ts";
import {LocationService,clikaBaseUrl} from "../lib/server/locations.ts";
import {ApiError} from "../lib/server/validation.ts";
import type {TestContext} from "node:test";
const uuid="11111111-2222-4333-8444-555555555555";
function setup(t:TestContext,mode:"external"|"demo"="external"){
 const directory=mkdtempSync(join(tmpdir(),"fieldlink-ops-test-"));t.after(()=>rmSync(directory,{recursive:true,force:true}));
 const repo=new FileRepository(directory,mode),svc=new MaintenanceService(repo),ops=new OperationsService(repo),locations=new LocationService(repo);
 if(mode==="demo")return{repo,svc,ops,locations,uuid:repo.read().daqs[0].uuid,sensor:repo.read().sensors[0],equipment:repo.read().equipment[0]};
 svc.upsertBoard({uuid,label:"DAQ",ip:"192.168.1.5",port:9000});const equipment=svc.saveEquipment({name:"발전기",category:"발전기",location:"A"});svc.bindBoard(uuid,{equipmentId:equipment.id});const sensor=svc.saveSensor({daqUuid:uuid,channel:"CH1",name:"진동",type:"vibration",position:"기존 위치",unit:"mm/s",sps:1000});return{repo,svc,ops,locations,uuid,sensor,equipment};
}
function planFor(ops:OperationsService,key=uuid,raw=true,logs=true){ops.savePolicy(key,{scope:"custom",from:"2026-01-01T00:00:00Z",to:"2026-01-01T01:00:00Z",raw,logs,maxMB:1});return ops.createPlan(key);}
const log={timestamp:"2026-01-01T00:20:00Z",level:"warning",code:"BUFFER",message:"오프라인 저장",metadata:{test:true}};
const batch={sequence:0,batchId:"batch-1",frame:{readings:[{channel:"CH1",timestamp:"2026-01-01T00:20:00Z",value:1,sps:1000,raw:[1,2,-1]}]},logs:[log]};
test("older store migrates, disconnection logs once, reconnect queues one recovery",t=>{const{repo,ops}=setup(t);assert.equal(repo.read().operations,undefined);ops.reconcile();repo.mutate(s=>{s.daqs[0].lastSeen=new Date(Date.now()-60000).toISOString();});ops.reconcile();ops.reconcile();assert.equal(state(repo.read()).logs.filter(l=>l.code==="DAQ_DISCONNECTED").length,1);ops.heartbeat(uuid);ops.heartbeat(uuid);const stateNow=state(repo.read());assert.equal(stateNow.recoveries.length,1);assert.equal(stateNow.logs.filter(l=>l.code==="DAQ_RECONNECTED").length,1);});
test("demo disconnection persists across telemetry ticks",t=>{const{repo,svc,ops,uuid}=setup(t,"demo");ops.reconcile();ops.demoConnection(uuid,false);repo.mutate(s=>{s.lastDemoTick=0;});svc.advanceDemo();assert.equal(svc.snapshot().daqs.find(d=>d.uuid===uuid)?.online,false);ops.demoConnection(uuid,true);assert.equal(svc.snapshot().daqs.find(d=>d.uuid===uuid)?.online,true);});
test("recovery has strict sequence, content-aware retries and original gzip archive",t=>{const{ops,repo}=setup(t);const plan=planFor(ops);assert.throws(()=>ops.receiveBatch(plan.id,{...batch,sequence:1}),/다음 배치/);assert.equal(ops.receiveBatch(plan.id,batch).duplicate,false);assert.equal(ops.receiveBatch(plan.id,batch).duplicate,true);assert.throws(()=>ops.receiveBatch(plan.id,{...batch,logs:[{...log,message:"changed"}]}),/내용이 변경/);const original=JSON.parse(gunzipSync(ops.archive(plan.id,0).bytes).toString());assert.deepEqual(original.frame.readings[0].raw,[1,2,-1]);assert.equal(state(repo.read()).recoveries[0].rawRecovered,1);assert.equal(state(repo.read()).recoveries[0].logsRecovered,1);});
test("time range export combines raw and logs as compressed JSONL",t=>{const{ops}=setup(t);const plan=planFor(ops);ops.receiveBatch(plan.id,batch);const archive=ops.exportRange(uuid,"2026-01-01T00:19:59Z","2026-01-01T00:21:00Z",true,true),rows=gunzipSync(archive.bytes).toString().trim().split("\n").map(line=>JSON.parse(line));assert.equal(rows[0].schema,"fieldlink.export.v1");assert.equal(rows.filter(row=>row.type==="sensor_raw").length,1);assert.deepEqual(rows.find(row=>row.type==="sensor_raw").raw,[1,2,-1]);assert.equal(rows.filter(row=>row.type==="device_log").length,1);});
test("MVP normal range is selected and integrity-approved by the user",t=>{const{ops,sensor}=setup(t);const plan=planFor(ops);const full={...batch,frame:{readings:[{...batch.frame.readings[0],raw:Array(1000).fill(1)}]}};ops.receiveBatch(plan.id,full);let result=ops.trainingReadiness(sensor.id,"2026-01-01T00:19:59Z","2026-01-01T00:21:00Z");assert.equal(result.rawBatches,1);assert.equal(result.hotBatches,0);assert.equal(result.recoveredBatches,1);assert.equal(result.rawSamples,1000);assert.equal(result.estimatedWindows,1);assert.equal(result.normalReviewState,"unreviewed");assert.equal(result.recommendedWindows,60);assert.equal(result.dataReady,true);assert.throws(()=>ops.approveNormalRange(sensor.id,{from:result.from,to:result.to,confirmNormal:true}),/무결성/);const approval=ops.approveNormalRange(sensor.id,{from:result.from,to:result.to,confirmNormal:true,acceptIntegrity:true});assert.equal(approval.integrityAccepted,true);result=ops.trainingReadiness(sensor.id,result.from,result.to);assert.equal(result.normalReviewState,"approved");assert.equal(result.requirements.find(row=>row.id==="operator")?.ok,true);});
test("invalid logs or raw cannot partially commit recovery",t=>{const{ops,repo}=setup(t);const plan=planFor(ops),before=readFileSync(repo.filename,"utf8");assert.throws(()=>ops.receiveBatch(plan.id,{...batch,logs:[{...log,timestamp:"2025-01-01T00:00:00Z"}]}),/범위/);assert.equal(readFileSync(repo.filename,"utf8"),before);assert.throws(()=>ops.receiveBatch(plan.id,{...batch,frame:{readings:[{...batch.frame.readings[0],channel:"missing"}]}}),ApiError);assert.equal(readFileSync(repo.filename,"utf8"),before);assert.throws(()=>ops.receiveBatch(plan.id,{...batch,frame:{readings:[{...batch.frame.readings[0],timestamp:plan.to,sps:1}]}}),/마지막 샘플/);assert.equal(readFileSync(repo.filename,"utf8"),before);});
test("recovery completion requires exact sequence and declared coverage, persists gaps",t=>{const{ops}=setup(t);const plan=planFor(ops);ops.receiveBatch(plan.id,batch);const completion={edgeComplete:true,rawCoveredThrough:plan.to,logsCoveredThrough:plan.to,finalSequence:0,missing:[{stream:"raw",from:plan.from,to:"2026-01-01T00:10:00Z",reason:"엣지 보관 만료"}]};assert.throws(()=>ops.completePlan(plan.id,{...completion,rawCoveredThrough:plan.from}),/부족/);assert.throws(()=>ops.completePlan(plan.id,{...completion,finalSequence:1}),/마지막 배치/);assert.equal(ops.completePlan(plan.id,completion).status,"completed_with_gaps");assert.equal(ops.completePlan(plan.id,completion).missing.length,1);});
test("recovery rejects disabled stream and capacity overflow",t=>{const{ops,repo}=setup(t);let plan=planFor(ops,uuid,false,true);assert.throws(()=>ops.receiveBatch(plan.id,batch),/Raw 복구/);ops.cancelPlan(plan.id);plan=planFor(ops);repo.mutate(s=>{state(s).recoveries.find(p=>p.id===plan.id)!.maxBytes=1;});assert.throws(()=>ops.receiveBatch(plan.id,batch),(e:unknown)=>e instanceof ApiError&&e.status===413);});
test("generator incident groups symptoms and marks healthy downstream separately; no cycles",t=>{const{repo,svc,ops}=setup(t,"demo");const snapshot=svc.snapshot(),result=ops.snapshot(snapshot),pump=result.impacts.find(i=>i.equipmentId==="eq-3");assert.equal(pump?.state,"upstream_blocked");assert.equal(snapshot.equipment.find(e=>e.id==="eq-3")?.severity,"normal");assert.equal(result.incidents.filter(i=>i.status==="active").length,1);assert.ok(result.incidents[0].affectedEquipmentIds.includes("eq-2"));assert.ok(result.incidents[0].affectedEquipmentIds.includes("eq-3"));assert.throws(()=>ops.saveDependency({from:"eq-3",to:"eq-1",kind:"power",required:true}),/순환/);ops.removeDependency("demo-power-pump");ops.saveDependency({from:"eq-1",to:"eq-3",kind:"power",required:false});assert.equal(ops.snapshot(svc.snapshot()).impacts.find(i=>i.equipmentId==="eq-3")?.state,"upstream_risk");assert.equal(repo.read().diagnoses.find(d=>d.sensorId===snapshot.equipment.find(e=>e.id==="eq-3")?.sensors[0].id)?.severity,"normal");});
test("manual incident merge keeps parents and diagnostics unchanged",t=>{const{repo,svc,ops}=setup(t,"demo");repo.mutate(s=>{s.diagnoses.filter(d=>s.sensors.find(x=>x.id===d.sensorId)?.daqUuid===s.daqs[3].uuid).forEach(d=>d.severity="critical");});const before=repo.read().diagnoses;const incidents=ops.snapshot(svc.snapshot()).incidents.filter(i=>i.status==="active");assert.equal(incidents.length,2);const merged=ops.mergeIncidents({ids:incidents.map(i=>i.id),title:"공통 전원 사건"});assert.equal(ops.snapshot(svc.snapshot()).incidents.filter(i=>i.status==="active").length,1);assert.equal(merged.manual,true);assert.equal(state(repo.read()).incidents.filter(i=>i.status==="merged").length,2);assert.deepEqual(repo.read().diagnoses,before);});
test("CLIKA cloud URL is blocked and localhost works",t=>{const previous=process.env.CLIKA_BASE_URL;t.after(()=>{if(previous===undefined)delete process.env.CLIKA_BASE_URL;else process.env.CLIKA_BASE_URL=previous;});process.env.CLIKA_BASE_URL="https://api.openai.com/v1";assert.throws(()=>clikaBaseUrl(),/폐쇄망/);process.env.CLIKA_BASE_URL="http://127.0.0.1:8000/v1";assert.equal(clikaBaseUrl(),process.env.CLIKA_BASE_URL);});
test("CLIKA contract sends local image, validates evidence and requires approval before updating position",async t=>{const{locations,repo,sensor}=setup(t);const oldModel=process.env.CLIKA_MODEL,oldUrl=process.env.CLIKA_BASE_URL;t.after(()=>{if(oldModel===undefined)delete process.env.CLIKA_MODEL;else process.env.CLIKA_MODEL=oldModel;if(oldUrl===undefined)delete process.env.CLIKA_BASE_URL;else process.env.CLIKA_BASE_URL=oldUrl;});process.env.CLIKA_MODEL="local-vision";process.env.CLIKA_BASE_URL="http://127.0.0.1:8000/v1";const input=locations.upload(uuid,[{filename:"bearing.png",mime:"image/png",bytes:Buffer.from("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=","base64")}])[0];
 const valid={summary:"베어링 부착 위치 후보",proposals:[{sensorId:sensor.id,position:"구동측 베어링",evidence:"사진 라벨 CH1",confidence:.8,inputId:input.id,page:null,box:{x:.1,y:.2,w:.3,h:.2}}]};let captured="";const fetcher=(async(url,options)=>{assert.equal(String(url),"http://127.0.0.1:8000/v1/chat/completions");captured=String(options?.body);return Response.json({choices:[{finish_reason:"stop",message:{content:JSON.stringify(valid)}}]});}) as typeof fetch;
 const analysis=await locations.analyze(uuid,{inputIds:[input.id]},fetcher);assert.ok(captured.includes("data:image/png;base64,"));assert.ok(!captured.includes('"response_format"'));assert.equal(repo.read().sensors[0].position,"기존 위치");locations.approve(analysis.id,{sensorId:sensor.id});assert.equal(repo.read().sensors[0].position,"구동측 베어링");valid.proposals[0].sensorId="invented";await assert.rejects(locations.analyze(uuid,{inputIds:[input.id]},fetcher),/등록되지 않은/);
});
