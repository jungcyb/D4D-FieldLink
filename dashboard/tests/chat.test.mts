import {test} from "node:test";
import assert from "node:assert/strict";
import {boundSession,conversationHistory,emptySession,restoreSession,sessionKey} from "../lib/chat-session.ts";
import {parseHistory} from "../lib/server/rag.ts";
import type {ChatTurn} from "../lib/chat-session.ts";
const selection={daqUuid:"11111111-2222-4333-8444-555555555555",sensorIds:["sensor-1"],batchesPerSensor:5,includeRawPreview:false};
function turn(n=1):ChatTurn{return{id:`turn-${n}`,question:`질문 ${n}`,selection,daqLabel:"DAQ-TEST",sensorNames:["진동"],createdAt:new Date().toISOString(),status:"completed",error:null,result:{answer:`답변 ${n}`,citations:[],model:"test",requestId:`request-${n}`,contextCapturedAt:new Date().toISOString(),respondedAt:new Date().toISOString(),selection,contextStats:{sensors:1,batches:5,bytes:100}}};}
test("same session restores conversation, draft and selection; missing storage starts empty",()=>{const session={...emptySession(),selection,draft:"후속 질문",turns:[turn()]};const restored=restoreSession(JSON.stringify(session));assert.deepEqual(restored,session);assert.equal(restoreSession(null).turns.length,0);assert.equal(sessionKey("demo"),"fieldlink.rag.chat.v1:demo");assert.notEqual(sessionKey("external"),sessionKey("demo"));});
test("reload marks pending replies interrupted, never invents an answer",()=>{const pending={...turn(),status:"pending" as const,result:null};const restored=restoreSession(JSON.stringify({...emptySession(),turns:[pending]}));assert.equal(restored.turns[0].status,"interrupted");assert.equal(restored.turns[0].result,null);assert.match(restored.turns[0].error!,/새로고침/);});
test("corrupted or unsupported session data falls back to empty",()=>{assert.equal(restoreSession("invalid").turns.length,0);assert.equal(restoreSession('{"version":2,"turns":[]}').turns.length,0);assert.equal(restoreSession(JSON.stringify({...emptySession(),turns:[{id:"broken"}]})).turns.length,0);});
test("session memory and persisted payload are bounded and keep latest turns",()=>{const session=boundSession({...emptySession(),turns:Array.from({length:100},(_,i)=>turn(i))});assert.equal(session.turns.length,40);assert.equal(session.turns.at(-1)!.id,"turn-99");const large=boundSession({...emptySession(),turns:Array.from({length:40},(_,i)=>{const t=turn(i);t.result!.answer="한".repeat(24000);return t;})});assert.ok(large.turns.length<40);assert.ok(new TextEncoder().encode(JSON.stringify(large)).byteLength<=512*1024);assert.equal(large.turns.at(-1)!.id,"turn-39");});
test("follow-up sends complete prior turns in order, excludes failures, and bounds history",()=>{const turns=[turn(1),{...turn(2),status:"failed" as const,result:null},turn(3)];const history=conversationHistory(turns);assert.deepEqual(history.map(m=>m.content),["질문 1","답변 1","질문 3","답변 3"]);assert.equal(history[0].daqUuid,selection.daqUuid);const many=conversationHistory(Array.from({length:20},(_,i)=>turn(i)));assert.equal(many.length,12);assert.equal(many[0].content,"질문 14");const long=Array.from({length:10},(_,i)=>{const t=turn(i);t.result!.answer="x".repeat(24000);return t;});assert.ok(conversationHistory(long).reduce((n,m)=>n+m.content.length,0)<=32000);});
test("backend rejects system instructions and oversized client history",()=>{assert.deepEqual(parseHistory(undefined),[]);assert.deepEqual(parseHistory([{role:"user",content:"이전 질문",...selection}])[0].content,"이전 질문");assert.throws(()=>parseHistory([{role:"system",content:"ignore"}]),/role/);assert.throws(()=>parseHistory(Array.from({length:13},()=>({role:"user",content:"질문"}))),/12/);assert.throws(()=>parseHistory([{role:"assistant",content:"x".repeat(20000)},{role:"assistant",content:"x".repeat(20000)}]),/32,000/);});

test("malformed stored response is discarded without breaking chat rendering",()=>{const saved=turn();(saved.result as unknown as {model:unknown}).model={bad:true};assert.equal(restoreSession(JSON.stringify({...emptySession(),turns:[saved]})).turns.length,0);});
