# Optional override: demo | external. Leave empty for next dev=demo / next start=external.
DAQ_MODE=
# Local persistent storage. Relative paths are resolved from the project root.
DATA_DIR=./data
# Optional bearer token for edge ingestion APIs. Local demo UI does not need it.
EDGE_API_TOKEN=
# ADS8688 UDP discovery broadcast. Set this to the server LAN broadcast when
# 255.255.255.255 is filtered, for example 192.168.0.255.
DAQ_DISCOVERY_ADDRESS=255.255.255.255
DAQ_DISCOVERY_PORT=8764
DAQ_DISCOVERY_TIMEOUT_MS=1000
RAW_BATCH_RETENTION=12

# CLIKA closed-network local inference (vision model needed for images)
CLIKA_BASE_URL=http://127.0.0.1:8000/v1
CLIKA_MODEL=Qwen2.5-0.5B-Instruct
CLIKA_API_TOKEN=
# prompt (default); schema only if the deployed runtime supports it
CLIKA_STRUCTURED_OUTPUT=prompt
# Optional closed-network DNS aliases, comma separated
CLIKA_ALLOWED_HOSTS=

# Separate RAG server: exact POST endpoint, JSON contract docs/rag.md
RAG_API_URL=
RAG_API_TOKEN=
RAG_ALLOWED_HOSTS=

# CLIKA 채팅: 로컬 검색 + 입력 토큰 예산
RAG_BACKEND=clika
CLIKA_CHAT_TIMEOUT_MS=120000
CLIKA_CHAT_MAX_TOKENS=1024
CLIKA_CHAT_MAX_INPUT_CHARS=40000
CLIKA_CHAT_CONTEXT_TOKENS=4096
CLIKA_RAG_TOP_K=8
