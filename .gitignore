/,ref/
# Local CCS workspace state and separately cloned reference sources.
/firmware/.theia/
/firmware/r5f_fallback/reference/

# Guard old locations too, in case a local file is recreated.
/connection.txt
/conneciton.txt
/plan.md
/todo.md
/sampleusecase.txt
/client/host.txt
/tools/ssh/known_hosts
/tools/drivers/
/backups/
/.legacy/
/dashboard/*-raw.csv
.ssh-askpass.cmd
.dt-audit.sh

# Locally rendered PDF inspection artifacts.
tmp/
.tmp/
__pycache__/
*.pyc
.venv*/
**/.venv/
.idea/
integration/state/
anamolydetection/*.zip
anamolydetection/**/outputs/
anamolydetection/**/candidates/
